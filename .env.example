# ===== Docker Compose · Atlético Palma del Río =====

# Puertos expuestos en el host
FRONTEND_PORT=8080
BACKEND_PORT=4000
DB_PORT=3306

# MySQL
MYSQL_ROOT_PASSWORD=rootpass
DB_NAME=atletico_palma_intranet
DB_USER=apr_user
DB_PASSWORD=apr_pass

# Backend
NODE_ENV=production
CORS_ORIGIN=http://localhost:8080
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio_en_produccion
JWT_EXPIRES_IN=8h
AES_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
BCRYPT_SALT_ROUNDS=12

# Admin inicial (se crea al arrancar el backend si SEED_ON_START=true)
SEED_ON_START=true
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=Admin#2026
