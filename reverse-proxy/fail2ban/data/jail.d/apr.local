# Jails de la intranet (fail2ban en contenedor, ver docker-compose: servicio
# fail2ban). Banea a nivel de cortafuegos del host (iptables) durante un rato.
# Umbrales altos a propósito: la app ya tiene límite por IP (10/15min) y bloqueo
# por cuenta (5 fallos); aquí solo se corta el abuso sostenido.

[DEFAULT]
# Baneo con iptables (no nftables) para poder apuntar a la cadena DOCKER-USER.
banaction = iptables-multiport
# Ignorar localhost. Añadir aquí la IP fija del club si hiciera falta, para no
# arriesgar un auto-baneo.
ignoreip = 127.0.0.1/8 ::1

# Abuso del login / 2FA contra el reverse-proxy (que es un CONTENEDOR): el
# tráfico a 80/443 va DNATeado por FORWARD, así que el baneo debe insertarse en
# la cadena DOCKER-USER, no en INPUT (en INPUT no cortaría nada).
[apr-login]
enabled  = true
filter   = apr-login
logpath  = /var/log/apr/access.log
maxretry = 10
findtime = 600
bantime  = 1800
action   = iptables-multiport[name=apr-login, port="http,https", protocol=tcp, chain="DOCKER-USER"]

# SSH del host: golpea INPUT directamente (no es un contenedor), cadena por
# defecto. Se lee el fichero montado (el host usa journald, pero el fichero
# /var/log/auth.log está vivo y sirve igual).
[sshd]
enabled  = true
backend  = auto
logpath  = /var/log/auth.log
maxretry = 5
findtime = 600
bantime  = 3600
