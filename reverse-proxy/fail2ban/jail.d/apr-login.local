# Jail fail2ban para los intentos de login/2FA del reverse-proxy.
# Umbral alto a propósito: la app ya tiene límite por IP (10/15min) y bloqueo
# por cuenta (5 fallos), así que aquí solo se banea el abuso sostenido. Banea a
# nivel de cortafuegos (iptables) en 80/443 durante 30 min.
[apr-login]
enabled  = true
filter   = apr-login
logpath  = /home/ubuntu/atleticopalmadelrio/reverse-proxy/logs/access.log
maxretry = 10
findtime = 600
bantime  = 1800
ignoreip = 127.0.0.1/8 ::1
action   = iptables-multiport[name=apr-login, port="http,https", protocol=tcp]
