{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npx vitest run:*)",
      "Bash(npm test:*)",
      "Bash(npx vite build:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(docker compose ps:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./backend/.env)",
      "Read(./backups/**)",
      "Read(**/*.pem)",
      "Bash(docker compose down -v:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
